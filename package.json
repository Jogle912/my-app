{
  "name": "studypilot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w @studypilot/server",
    "dev:mobile": "npm run start -w @studypilot/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @studypilot/server",
    "plan:demo": "npm run plan:demo -w @studypilot/server",
    "db:up": "docker compose up -d db",
    "db:deploy": "npm run db:deploy -w @studypilot/server"
  }
}
