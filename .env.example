# Copy to .env.local and fill in. Never commit real values.

# Database (matches docker-compose.yml). Tests use separate *_test and *_e2e databases.
DATABASE_URL=postgresql://studypilot:studypilot@localhost:5432/studypilot
# DATABASE_URL_TEST=postgresql://studypilot:studypilot@localhost:5432/studypilot_test
# DATABASE_URL_E2E=postgresql://studypilot:studypilot@localhost:5432/studypilot_e2e

# App sign-in (Better Auth). Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 32-byte base64 key for encrypting stored OAuth tokens (M7). Generate: openssl rand -base64 32
TOKEN_ENC_KEY=

# Canvas OAuth developer key for a specific institution (M7). Leave empty to use mock Canvas data.
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Development only: a Canvas personal access token for YOUR OWN account, used by the
# read-only dev importer. Never use another person's token. Never set this in production.
CANVAS_DEV_PERSONAL_TOKEN=

# LLM provider (Phase 2)
ANTHROPIC_API_KEY=
